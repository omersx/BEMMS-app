# ==============================================================================
# BEMMS Environment Configuration
# ==============================================================================
# Copy this file to .env.local (development) or .env (production Docker)
# and fill in ALL required values before starting the application.
#
# NEVER commit .env.local or .env with real secrets to version control.
# ==============================================================================

# Database Configuration
DATABASE_URL=postgresql://bemms:YOUR_DB_PASSWORD_HERE@localhost:5432/bemms_db

# NextAuth Configuration
# NEXTAUTH_URL: Your full public URL (e.g., https://bemms.yourhospital.com)
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Initial Admin User Credentials
# Set a STRONG password for production (≥12 chars, mixed case, numbers, symbols)
ADMIN_EMAIL=admin@bemms.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator

# Node Environment (development | production)
NODE_ENV=development

# Web Push / VAPID Configuration
# Generate fresh keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Database Pool (production tuning — optional)
# DB_POOL_MAX=20
# DB_SSL=true

# Docker Production Domain
# DOMAIN=bemms.yourhospital.com

# PostgreSQL (for docker-compose.prod.yml)
# POSTGRES_USER=bemms
# POSTGRES_PASSWORD=
# POSTGRES_DB=bemms_db
